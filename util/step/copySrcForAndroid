#!/bin/bash

STEP=$((STEP+1))
echo -e "\n> > > > Step №$STEP. Copy src files to Android version"

SRC_FILES=(
  entities.kt
)

for file in ${SRC_FILES[@]}; do
    echo "> $file"
    cp $SRC_DIR/$file $AND_DIR
    path="$AND_DIR/$file"
    # Fix imports
    replace $path "import kotlin.js.JsExport" ""
    # Remove JS export
    replace $path "@JsExport" ""
done
